rules_version = '2';
// Palestra Matematica — regole multi-docente.
//  /docenti/{email}           docenti registrati (richiesta → attivo, approvati dall'amministratore)
//  /codici/{codice}           codice classe → id della classe (si legge solo conoscendo il codice)
//  /classi/{cid}              classe: nome, docenti, codice, ingressi aperti, elenco alunni, impostazioni
//  /classi/{cid}/membri/{uid} alunni entrati con il codice (accesso anonimo) e nome scelto dall'elenco
//  /classi/{cid}/stato/gara   gara in corso della classe
//  /classi/{cid}/{scores|live|presence|players|gare}/...  dati della classe
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- chi è chi ----------
    // Amministratore dell'app: approva i docenti. Cambia qui l'indirizzo se serve.
    function emailAdmin(){ return 'liberato.mazzotta@icoderzo.edu.it'; }
    function loggato(){ return request.auth != null; }
    function emailVerificata(){ return loggato() && request.auth.token.get('email_verified', false) == true && request.auth.token.get('email', '') != ''; }
    function isAdmin(){ return emailVerificata() && request.auth.token.email == emailAdmin(); }
    function docenteAttivo(){
      return emailVerificata()
        && exists(/databases/$(database)/documents/docenti/$(request.auth.token.email))
        && get(/databases/$(database)/documents/docenti/$(request.auth.token.email)).data.stato == 'attivo';
    }
    function classe(cid){ return get(/databases/$(database)/documents/classi/$(cid)).data; }
    function docenteDi(cid){ return docenteAttivo() && request.auth.token.email in classe(cid).docenti; }
    function membro(cid){ return get(/databases/$(database)/documents/classi/$(cid)/membri/$(request.auth.uid)).data; }
    // alunno della classe: entrato con il codice ATTUALE (se il docente rigenera il codice, deve rientrare)
    function alunnoDi(cid){
      return loggato()
        && exists(/databases/$(database)/documents/classi/$(cid)/membri/$(request.auth.uid))
        && membro(cid).codice == classe(cid).codice;
    }
    // l'alunno scrive solo a nome proprio (il nome scelto dall'elenco)
    function aNomeProprio(cid){
      return alunnoDi(cid) && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == membro(cid).nome;
    }
    function nomeOk(n){ return n is string && n.size() > 0 && n.size() <= 60; }

    // ---------- docenti ----------
    match /docenti/{email} {
      allow get: if emailVerificata() && (request.auth.token.email == email || isAdmin());
      allow list: if isAdmin();
      // un docente chiede l'accesso (stato "richiesta"); l'amministratore si registra già attivo
      // e può aggiungere direttamente l'email di un collega
      allow create: if request.resource.data.email == email
        && (isAdmin() || (emailVerificata() && request.auth.token.email == email
              && request.resource.data.stato == 'richiesta' && request.resource.data.ruolo == 'docente'));
      allow update, delete: if isAdmin();
    }

    // ---------- codici classe ----------
    match /codici/{codice} {
      allow get: if loggato();
      allow list: if false;
      allow create: if docenteDi(request.resource.data.classe);
      allow delete: if docenteDi(resource.data.classe);
      allow update: if false;
    }

    // ---------- classi ----------
    match /classi/{cid} {
      allow get: if docenteDi(cid) || alunnoDi(cid);
      // elenco delle proprie classi (query con array-contains sulla propria email)
      allow list: if docenteAttivo() && request.auth.token.email in resource.data.docenti;
      allow create: if docenteAttivo()
        && request.resource.data.proprietario == request.auth.token.email
        && request.resource.data.docenti == [request.auth.token.email]
        && nomeOk(request.resource.data.nome)
        && request.resource.data.alunni is list
        && request.resource.data.aperta is bool;
      allow update: if docenteDi(cid)
        && request.resource.data.proprietario == resource.data.proprietario
        && request.auth.token.email in request.resource.data.docenti
        && request.resource.data.proprietario in request.resource.data.docenti;
      allow delete: if docenteAttivo() && resource.data.proprietario == request.auth.token.email;

      // alunni entrati con il codice
      match /membri/{uid} {
        allow get: if (loggato() && request.auth.uid == uid) || docenteDi(cid);
        allow list: if docenteDi(cid);
        allow create, update: if loggato() && request.auth.uid == uid
          && classe(cid).aperta == true
          && request.resource.data.codice == classe(cid).codice
          && (request.resource.data.nome == null || request.resource.data.nome in classe(cid).alunni);
        allow delete: if docenteDi(cid) || (loggato() && request.auth.uid == uid);
      }

      // gara in corso: la scrive solo il docente
      match /stato/{doc} {
        allow read: if docenteDi(cid) || alunnoDi(cid);
        allow write: if docenteDi(cid);
      }

      // punteggi di fine manche: l'alunno li crea a nome proprio, mai modificabili
      match /scores/{id} {
        allow read: if docenteDi(cid) || alunnoDi(cid);
        allow create: if docenteDi(cid) || (aNomeProprio(cid)
          && request.resource.data.sessionId is number
          && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score < 100000
          && request.resource.data.manche is number && request.resource.data.manche >= 1 && request.resource.data.manche <= 10);
        allow update: if false;
        allow delete: if docenteDi(cid);
      }

      // punteggio parziale durante la manche, iscritti alla gara, presenza in esercitazione
      match /live/{id} {
        allow read: if docenteDi(cid) || alunnoDi(cid);
        allow create, update: if docenteDi(cid) || (aNomeProprio(cid)
          && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score < 100000);
        allow delete: if docenteDi(cid);
      }
      match /players/{id} {
        allow read: if docenteDi(cid) || alunnoDi(cid);
        allow create, update: if docenteDi(cid) || aNomeProprio(cid);
        allow delete: if docenteDi(cid);
      }
      match /presence/{id} {
        allow read: if docenteDi(cid) || (alunnoDi(cid) && resource.data.uid == request.auth.uid);
        allow create, update: if docenteDi(cid) || aNomeProprio(cid);
        allow delete: if docenteDi(cid);
      }

      // archivio delle gare della classe: solo il docente
      match /gare/{id} {
        allow read, write: if docenteDi(cid);
      }
    }
  }
}
