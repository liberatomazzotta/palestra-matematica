rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Stato della gara corrente: sessione, argomento, manche, orario di partenza,
    // numero di manches (nManche), modalità (mode: singola/squadre) e squadre (teams).
    // Senza login non si può distinguere in modo sicuro il docente dagli alunni:
    // il codice docente nell'app è solo un filtro di interfaccia.
    match /game/state {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['sessionId','topic','manche','startAt','duration','updatedAt'])
                   && request.resource.data.sessionId is number
                   && request.resource.data.topic is string
                   && request.resource.data.manche is number
                   && request.resource.data.duration is number;
    }

    // Punteggi: si possono solo creare (mai modificare né cancellare),
    // con una forma dei dati controllata.
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['sessionId','topic','name','score','manche','ts'])
                    && request.resource.data.sessionId is number
                    && request.resource.data.topic is string
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0
                    && request.resource.data.score < 100000
                    && request.resource.data.manche is number
                    && request.resource.data.manche >= 1
                    && request.resource.data.manche <= 10;
      allow update: if false;
      // Cancellazione consentita (pulsanti "Cancella" del Pannello docente). Senza login non si può
      // distinguere il docente: in teoria chi conosce l'app potrebbe cancellare i punteggi.
      allow delete: if true;
    }

    // Presenza degli alunni in allenamento (mosaico docente): un documento per alunno,
    // sovrascritto; cancellabile dal Pannello docente.
    match /presence/{pid} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['name','topic','correct','wrong','streak','recent','lastTs','active'])
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 40
                            && request.resource.data.topic is string
                            && request.resource.data.correct is number
                            && request.resource.data.wrong is number
                            && request.resource.data.streak is number
                            && request.resource.data.recent is string
                            && request.resource.data.recent.size() <= 6
                            && request.resource.data.lastTs is number
                            && request.resource.data.active is bool;
      allow delete: if true;
    }

    // Iscritti alla gara (sala d'attesa del Cruscotto docente, per comporre le squadre).
    match /players/{pid} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['sessionId','name','ts'])
                            && request.resource.data.sessionId is number
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 40
                            && request.resource.data.ts is number;
      allow delete: if true;
    }

    // Archivio gare: una scheda riassuntiva per gara (impostazioni, squadre, classifica finale).
    match /gare/{gid} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['sessionId','topic','nManche','mode'])
                            && request.resource.data.sessionId is number
                            && request.resource.data.topic is string
                            && request.resource.data.nManche is number
                            && request.resource.data.mode is string;
      allow delete: if true;
    }

    // Punteggio parziale durante la manche (vista "Gara live" del docente).
    match /live/{lid} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['sessionId','manche','name','score','correct','wrong','lastTs'])
                            && request.resource.data.sessionId is number
                            && request.resource.data.manche is number
                            && request.resource.data.manche >= 1
                            && request.resource.data.manche <= 10
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 40
                            && request.resource.data.score is number
                            && request.resource.data.score >= 0
                            && request.resource.data.score < 100000
                            && request.resource.data.correct is number
                            && request.resource.data.wrong is number
                            && request.resource.data.lastTs is number;
      allow delete: if true;
    }
  }
}
